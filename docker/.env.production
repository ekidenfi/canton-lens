# Committed PUBLIC-ONLY environment for production browser-oidc builds.
#
# Read by the `Publish images and charts` workflow on `v*` tags to bake the
# frontend bundle (`docker/frontend.Dockerfile` build args). Every value here
# ends up as a literal inside the browser bundle, so NOTHING SECRET may ever
# be added to this file: no client secret, no token, no
# `SHARED_IDENTITY_*` — the workflow refuses the build if a `*SECRET*` line
# appears. Backend credentials stay in deployment-time env / Secret managers.
#
# Local development still uses the gitignored `docker/.env`; this file is
# only for CI builds of the published `browser-oidc-*` frontend images.
#
# TODO(prod): register both redirect URIs as allowed callbacks with
# the issuer. All three URLs must share one origin and directory with the
# Explorer itself.

EXPLORER_PORT=8080
EXPLORER_BIND=127.0.0.1

VITE_AUTH_MODE=browser-oidc
LEDGER_AUTH_MODE=caller-bearer

LEDGER_BASE=https://api.validator.cnm.ekiden.fi

PUBLIC_ENTRY_URL=https://explorer.production.ekiden.fi/

# ── browser-oidc (Auth0, public client — values visible in the bundle) ──
VITE_OIDC_ISSUER=https://ekiden-canton-mainnet.jp.auth0.com
VITE_OIDC_CLIENT_ID=KFSYOWU3w5IhoX2YI0nnakxeBfaIvSPx
VITE_OIDC_REDIRECT_URI=https://explorer.production.ekiden.fi/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://explorer.production.ekiden.fi/
VITE_OIDC_SCOPES=openid profile
VITE_OIDC_AUDIENCE=https://canton.network.global
