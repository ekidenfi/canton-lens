# Committed PUBLIC-ONLY environment for staging browser-oidc builds.
#
# Read by the `Publish images and charts` workflow on pushes to `main` to bake
# the frontend bundle (`docker/frontend.Dockerfile` build args). Every value
# here ends up as a literal inside the browser bundle, so NOTHING SECRET may
# ever be added to this file: no client secret, no token, no
# `SHARED_IDENTITY_*` — the workflow refuses the build if a `*SECRET*` line
# appears. Backend credentials stay in deployment-time env / Secret managers.
#
# Copied from `docker/.env.production`. Both files currently point at the
# same ledger and issuer; point staging at a staging ledger/issuer if one
# exists.
#
# TODO(staging): register both redirect URIs as allowed callbacks with
# the issuer. All three URLs must share one origin and directory with the
# Explorer itself.

EXPLORER_PORT=8080
EXPLORER_BIND=127.0.0.1

VITE_AUTH_MODE=browser-oidc
LEDGER_AUTH_MODE=caller-bearer

LEDGER_BASE=https://api.validator.cnt.ekiden.fi

PUBLIC_ENTRY_URL=https://explorer.staging.ekiden.fi/

# ── browser-oidc (Auth0, public client — values visible in the bundle) ──
VITE_OIDC_ISSUER=https://dev-vxaql0tmpebv1mbu.us.auth0.com
VITE_OIDC_CLIENT_ID=i9urQfnxf3Sp9Xl91VRWqf58oPKUK6H0
VITE_OIDC_REDIRECT_URI=https://explorer.staging.ekiden.fi/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://explorer.staging.ekiden.fi/
VITE_OIDC_SCOPES=openid profile
VITE_OIDC_AUDIENCE=https://canton.network.global
